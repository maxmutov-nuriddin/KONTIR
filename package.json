{
  "name": "kontir-tactical-fps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"node server/src/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node server/src/index.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser-smoke.mjs"
  },
  "dependencies": {
    "three": "^0.180.0",
    "gsap": "^3.13.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "vite": "^7.1.7",
    "concurrently": "^9.2.1",
    "@playwright/test": "^1.63.0"
  }
}
