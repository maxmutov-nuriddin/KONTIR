{
  "name": "kontir-tactical-fps",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node tools/scan-models.mjs && node tools/build-maps.mjs --if-missing",
    "dev": "concurrently -k -n server,client -c yellow,cyan \"node server/server.js\" \"vite --host 0.0.0.0\"",
    "prestart": "npm run build",
    "start": "node server/server.js",
    "maps": "node tools/build-maps.mjs",
    "prebuild": "node tools/scan-models.mjs && node tools/build-maps.mjs --if-missing",
    "build": "vite build",
    "build:zip": "npm run build && cd dist && zip -r ../kontir-yandex.zip . -x \"*.DS_Store\" && cd ..",
    "pretest": "node tools/scan-models.mjs && node tools/build-maps.mjs --if-missing",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:browser:local": "node tests/run-browser.mjs",
    "test:browser:rounds": "node tests/browser-rounds.mjs",
    "test:browser:friends": "node tests/browser-friends.mjs",
    "models": "node tools/scan-models.mjs && node tools/build-maps.mjs"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "mongodb": "^7.7.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.9.15",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.2.1"
  }
}
